# ================================================
# OH-MY-LOGO PRO - Configuration
# ================================================

# ------------------------------------------------
# AI Provider Settings (Default: Claude Opus 4.5)
# ------------------------------------------------

# Default provider: claude | openrouter | ollama | lmstudio | openai
AI_DEFAULT_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-5-20250514

# OpenRouter (100+ models)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# LM Studio (Local)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# OpenAI (Optional)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo

# ------------------------------------------------
# Application Settings
# ------------------------------------------------

# GUI Settings
GUI_THEME=dark
GUI_FONT_SIZE=14
GUI_TERMINAL_ROWS=10

# Export Settings
EXPORT_DEFAULT_FORMAT=png
EXPORT_DEFAULT_DPI=300
EXPORT_BACKGROUND=transparent

# Memory Settings
MEMORY_ENABLED=true
MEMORY_MAX_PROJECTS=100
MEMORY_AUTO_SAVE=true
MEMORY_SAVE_INTERVAL=30000

# Timeline Settings
TIMELINE_MAX_HISTORY=500
TIMELINE_AUTO_SNAPSHOT=true

# ------------------------------------------------
# Development Settings
# ------------------------------------------------

# Debug mode
DEBUG=false
LOG_LEVEL=info

# Performance
CACHE_ENABLED=true
WORKERS_ENABLED=true
